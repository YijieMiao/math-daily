.trend { margin: 24rpx 26rpx; padding: 24rpx; border: 1rpx solid #e1e1d6; border-radius: 14rpx; background: #fffdfa; }
.title { font-weight: bold; font-size: 31rpx; }
.controls { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.controls button { margin: 0; padding: 0 12rpx; background: #edf0e8; font-size: 22rpx; }
.disabled { opacity: .48; text-decoration: line-through; }
.plot { width: 100%; height: 380rpx; margin-top: 16rpx; }
.note { color: #58665f; font-size: 23rpx; line-height: 1.5; margin-top: 8rpx; }
